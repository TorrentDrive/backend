# ============================================================
# TorrentDrive Backend — Environment Configuration
# ============================================================
# Copy this file to .env and customize the values below
# ============================================================

ASPNETCORE_ENVIRONMENT=Production

# -----------------------------------------------------------
# Database (PostgreSQL) — Port Mappings
# -----------------------------------------------------------
# POSTGRES_PORT is the EXTERNAL port (localhost:47300)
# The container always uses port 5432 internally
POSTGRES_DB=torrentdrive
POSTGRES_USER=torrentdrive_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=47300

# -----------------------------------------------------------
# Redis — Port Mapping
# -----------------------------------------------------------
# REDIS_PORT is the EXTERNAL port (localhost:47400)
# The container always uses port 6379 internally
REDIS_PORT=47400

# -----------------------------------------------------------
# API — Port Mapping
# -----------------------------------------------------------
# API_PORT is the EXTERNAL port (localhost:47200)
# The container always uses port 8080 internally
API_PORT=47200
FRONTEND_URL=http://localhost:47100
APPLY_MIGRATIONS=true

# -----------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_ISSUER=TorrentDrive_API
JWT_AUDIENCE=TorrentDrive_Client

# -----------------------------------------------------------
# Admin Credentials — legacy bootstrap only
# -----------------------------------------------------------
# Leave these unset. The account is created by the first-run setup wizard and
# the password is stored hashed on the user row.
#
# They are still honoured for installs that predate the wizard: the first
# successful login with them converts that account to a stored password, after
# which they can be removed. Setting them DISABLES the setup wizard, because an
# instance whose owner already has a way in must not offer itself to whoever
# reaches it first.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# -----------------------------------------------------------
# Workers
# -----------------------------------------------------------
# Seeds the initial value only. Once a worker count is saved in Settings, that
# is what applies and this is ignored.
HANGFIRE_WORKER_COUNT=10
# Where torrents are downloaded before upload. Must match the downloads volume
# mount, and is shared by the API and every worker: the API needs it to inspect
# and purge the volume, and the upload workers need it to reclaim finished jobs.
TORRENT_DOWNLOAD_PATH=/app/downloads

# Note: deleting a job's download directory after upload is no longer an
# environment variable. It is a per-user preference edited in Settings.

# -----------------------------------------------------------
# Upload Routing & Storage Failover
# -----------------------------------------------------------
# These three seed the SystemSettings row the first time it is created, so an
# install tuned through the environment keeps its tuning across the upgrade.
# After that the Settings tab is authoritative and these are ignored.
#
# When a destination drive is unreachable (revoked token, no quota left),
# move the upload to another healthy account of the same provider instead
# of failing the job. Set to false to always fail on the chosen drive.
UPLOAD_ROUTING_ENABLE_FAILOVER=true
# Maximum automatic reroutes per job.
UPLOAD_ROUTING_MAX_FAILOVER_ATTEMPTS=3
# Consecutive upload failures before a drive is treated as unhealthy.
UPLOAD_ROUTING_FAILURE_THRESHOLD=3

# -----------------------------------------------------------
# Observability — Serilog / Loki
# -----------------------------------------------------------
OBSERVABILITY_LOKI_URL=http://loki:3100
OBSERVABILITY_LOKI_USERNAME=
OBSERVABILITY_LOKI_API_KEY=

# -----------------------------------------------------------
# Observability — OpenTelemetry
# -----------------------------------------------------------
OBSERVABILITY_OTLP_ENDPOINT=
OBSERVABILITY_OTLP_HEADERS=
# Also seeded into SystemSettings; editable in Settings, applied on restart.
OBSERVABILITY_ENABLE_PROMETHEUS=true
OBSERVABILITY_ENABLE_TRACING=true

# -----------------------------------------------------------
# Grafana Dashboard (local observability stack)
# -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_please
